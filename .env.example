# Copy to .env.local for local development.

# Required. On Zeabur this points at the internal Postgres service.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required. Guards /admin and the CSV export.
ADMIN_TOKEN=any-long-random-string

# Cloudflare's published test pair: the widget always passes.
# Swap the secret to 2x0000000000000000000000000000000AA to test rejection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional. Defaults to the launch date baked into src/lib/sessions.ts.
# FIRST_SESSION_DATE=2026-08-06

# Optional, but set it on anything public. The site's own address, used for the
# absolute URLs in sitemap.xml, robots.txt and llms.txt, and for resolving the
# social-card image. Falls back to the production domain when unset, so a
# preview deployment without it describes production rather than itself.
NEXT_PUBLIC_SITE_URL=https://vibethursday.com

